[global]
    monitor = 0
    follow = keyboard
    width = 420
    height = 1000
    transparency = 0
    horizontal_padding = 2
    font = Monospace 12
    format = "<b>%s</b>\n<i>%b</i>"
    frame_color = "#3f1008"
	frame_width = 2
    timeout = 4

[urgency_normal]
    background = "#3f1803"
    foreground = "#ebdbb2"

[urgency_critical]
    background = "#f74747"
    foreground = "#282828"
